# --- Storage --------------------------------------------------------------
# When NEO4J_URI is set, the graph is stored in Neo4j (Cypher). When unset, an
# in-memory NetworkX graph is used, so the app and tests run with no database.
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# --- LLM narrator (optional) ---------------------------------------------
# When ANTHROPIC_API_KEY is set, campaign narratives are written by Claude.
# When unset, a deterministic template narrator is used instead.
# ANTHROPIC_API_KEY=sk-ant-...
TIG_MODEL=claude-opus-4-8

# --- Live collectors (optional) ------------------------------------------
# The collectors ship with offline sample pulls; set keys only to fetch live.
# OTX_API_KEY=
# VT_API_KEY=
